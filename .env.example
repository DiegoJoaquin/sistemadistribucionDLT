# Supabase. En local estos valores los imprime `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para scripts de administración (crear usuarios, cargar la línea base).
# NUNCA se expone al navegador ni se sube al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Envío del reporte semanal por correo
#
# El correo sale por SMTP desde la propia dirección de DLT, no desde un
# remitente de un servicio de terceros. Sirve igual con Google Workspace,
# Microsoft 365, Hostinger o cualquier otro: cambian el host y el puerto.
#
# Sin estas variables la aplicación funciona igual; solo que el botón de
# enviar dice qué falta y el reporte se sigue copiando a mano.
# ---------------------------------------------------------------------------

# El servidor de salida. Ejemplos:
#   Google Workspace / Gmail   smtp.gmail.com
#   Microsoft 365              smtp.office365.com
#   Hostinger                  smtp.hostinger.com
SMTP_HOST=

# 587 (STARTTLS) o 465 (SSL directo). Si no se pone, 587.
# No son intercambiables: equivocarlo da un error de conexión sin explicación.
SMTP_PUERTO=587

# Tu dirección de correo completa.
SMTP_USUARIO=

# La CONTRASEÑA DE APLICACIÓN, no la del buzón.
#
# Si el correo tiene verificación en dos pasos —y debería— la contraseña normal
# no funciona para SMTP. Se genera una específica, que se puede revocar sin
# cambiar la del correo:
#   Google:    myaccount.google.com → Seguridad → Contraseñas de aplicaciones
#   Microsoft: cuenta → Seguridad → Opciones avanzadas
SMTP_CLAVE=

# Opcionales. El remitente por defecto es SMTP_USUARIO, y casi todos los
# servidores rechazan cualquier otro: cámbialo solo si tu buzón tiene alias
# autorizados.
# SMTP_REMITENTE=
# SMTP_NOMBRE=KPIs DLT · Distribución

# A quiénes se manda el reporte semanal, separados por coma.
REPORTE_DESTINATARIOS=jefe@dltsports.cl, jefa@dltsports.cl
